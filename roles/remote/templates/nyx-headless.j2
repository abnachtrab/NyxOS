#!/usr/bin/env bash
# Create or remove the headless output that NyxOS streams from.
#
#   nyx-headless up [WIDTHxHEIGHT]
#   nyx-headless down
#   nyx-headless name
#
# Rendered by roles/remote. Called by hand for wayvnc, and by sunshine's
# prep commands so the output exists only while a stream does — Moonlight
# asks for a resolution, so `up` takes one.
#
# Hyprland assigns the name (HEADLESS-2 and so on) rather than accepting one,
# so it has to be discovered by diffing the monitor list before and after.
set -euo pipefail

HZ="{{ nyx_remote_refresh }}"

# Over SSH none of the session environment is set, so hyprctl prints
# "HYPRLAND_INSTANCE_SIGNATURE not set!" and anything piping it to jq dies
# with a parse error instead of a useful message. Find the running instance
# rather than requiring the caller to export three variables.
# Set unconditionally, not only in the branch below: the state file path is
# derived from it, and falling back to /tmp would put that somewhere every
# local account can write.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    sig=$(ls -1t "${XDG_RUNTIME_DIR}/hypr" 2>/dev/null | head -1 || true)
    if [[ -z "$sig" ]]; then
        echo "no Hyprland instance found under ${XDG_RUNTIME_DIR}/hypr" >&2
        echo "is the session running, and is this the user that owns it?" >&2
        exit 1
    fi
    export HYPRLAND_INSTANCE_SIGNATURE="$sig"
fi

STATE="${XDG_RUNTIME_DIR}/nyx-headless.name"

# hyprctl reports failure on stdout as plain text and still exits 0, so check
# the shape of the output rather than the exit status.
hypr_json() {
    local out
    out=$(hyprctl "$@" -j 2>&1) || true
    if [[ "${out:0:1}" != "[" && "${out:0:1}" != "{" ]]; then
        echo "hyprctl $* did not return JSON:" >&2
        echo "  ${out}" >&2
        exit 1
    fi
    printf '%s' "$out"
}

monitors() { hypr_json monitors | jq -r '.[].name' | sort; }

case "${1:-}" in
  up)
    RES="${2:-{{ nyx_remote_resolution }}}"
    if [[ -s "$STATE" ]] && monitors | grep -qx "$(cat "$STATE")"; then
      echo "already up: $(cat "$STATE")"
      exit 0
    fi
    before=$(monitors)
    hyprctl output create headless >/dev/null
    # Creation is asynchronous, so poll rather than sleeping a fixed amount
    # that is either too short or wasted time.
    name=""
    for _ in {1..20}; do
      name=$(comm -13 <(echo "$before") <(monitors) | head -1)
      [[ -n "$name" ]] && break
      sleep 0.1
    done
    if [[ -z "$name" ]]; then
      echo "no new output appeared after 'hyprctl output create headless'" >&2
      exit 1
    fi
    hyprctl keyword monitor "${name},${RES}@${HZ},auto,1" >/dev/null
    printf '%s\n' "$name" > "$STATE"
    echo "$name at ${RES}@${HZ}"
    ;;
  down)
    [[ -s "$STATE" ]] || { echo "nothing to remove"; exit 0; }
    name=$(cat "$STATE")
    hyprctl output remove "$name" >/dev/null || true
    rm -f "$STATE"
    echo "removed $name"
    ;;
  name)
    [[ -s "$STATE" ]] && cat "$STATE" || { echo "not up" >&2; exit 1; }
    ;;
  *)
    echo "usage: $0 {up [WIDTHxHEIGHT]|down|name}" >&2
    exit 1
    ;;
esac
