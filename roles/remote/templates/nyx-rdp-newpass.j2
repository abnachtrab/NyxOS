#!/usr/bin/env bash
# Write ~/.config/hypr-rdp/config.toml with a freshly generated password.
#
# Run at boot by nyx-rdp-password.service, and once by roles/remote so the
# config exists before the first reboot. hypr-rdp reads the file at start, so
# a password generated at boot is the one a session started afterwards uses.
#
# The password is regenerated rather than stored because nothing needs it to
# persist: it is read off the MOTD when connecting, and the service is bound
# to localhost behind key-only SSH, so it is a second factor rather than the
# security boundary.
set -Eeuo pipefail

CONFIG_DIR="${HOME}/.config/hypr-rdp"
CONFIG="${CONFIG_DIR}/config.toml"

# Hex, so the value can never contain a quote or a backslash that would need
# TOML escaping, and can be read off a screen and typed without ambiguity.
# 12 bytes is 96 bits.
password=$(openssl rand -hex 12)

mkdir -p "$CONFIG_DIR"
chmod 0700 "$CONFIG_DIR"

# Write via a temporary file and rename, so a reader never sees a
# half-written config, and create it 0600 rather than fixing the mode after.
tmp=$(mktemp "${CONFIG}.XXXXXX")
chmod 0600 "$tmp"
cat > "$tmp" <<EOF
# Generated by nyx-rdp-newpass. Regenerated on every boot; editing this file
# by hand lasts until the next one.
bind = "{{ nyx_rdp_bind }}:{{ nyx_rdp_port }}"
username = "{{ nyx_rdp_username }}"
password = "${password}"

resolution = "{{ nyx_remote_resolution }}"
fps = {{ nyx_rdp_fps }}
bitrate = {{ nyx_rdp_bitrate }}
quality = {{ nyx_rdp_quality }}
EOF
mv -f "$tmp" "$CONFIG"

echo "wrote ${CONFIG} with a new password"
