[Unit]
# A fresh RDP password on every boot. Ordered before the greeter so the
# config is in place before anything can start hypr-rdp.
Description=Generate a new hypr-rdp password
Before=greetd.service
After=local-fs.target

[Service]
Type=oneshot
User={{ nyx_user }}
Group={{ nyx_user }}
Environment=HOME=/home/{{ nyx_user }}
ExecStart=/usr/local/bin/nyx-rdp-newpass
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
