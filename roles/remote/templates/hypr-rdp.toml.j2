# Rendered by roles/remote. hypr-rdp reads this at start.
#
# Mode 0600: it holds the RDP password.
bind = "{{ nyx_rdp_bind }}:{{ nyx_rdp_port }}"
username = "{{ nyx_rdp_username }}"
password = "{{ nyx_rdp_password }}"

# The headless output, so a client gets its own screen rather than a scaled
# 5120x1440. Discovered at runtime — Hyprland assigns the name — so it is set
# on the command line by nyx-rdp rather than pinned here.

resolution = "{{ nyx_remote_resolution }}"
fps = {{ nyx_rdp_fps }}
bitrate = {{ nyx_rdp_bitrate }}
quality = {{ nyx_rdp_quality }}
