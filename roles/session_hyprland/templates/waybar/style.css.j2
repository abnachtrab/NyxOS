/* Colours are defined by roles/theme in ~/.config/waybar/theme.css. */
@import "theme.css";

* {
  font-family: "Meslo LG M Nerd Font", sans-serif;
  font-size: 13px;
  border: none;
  border-radius: 0;
  min-height: 0;
}

window#waybar {
  background: @nyx-bg;
  color: @nyx-fg;
}

#workspaces button {
  padding: 0 8px;
  color: @nyx-dim;
  background: transparent;
}

#workspaces button.active {
  color: @nyx-accent;
  box-shadow: inset 0 -2px @nyx-accent;
}

#workspaces button.urgent {
  color: @nyx-err;
}

#window {
  color: @nyx-dim;
  padding: 0 8px;
}

#clock {
  color: @nyx-fg;
  padding: 0 12px;
}

#pulseaudio,
#network,
#cpu,
#memory,
#tray {
  padding: 0 10px;
  color: @nyx-dim;
  background: @nyx-panel;
}

#pulseaudio { color: @nyx-second; }
#network    { color: @nyx-accent; }
