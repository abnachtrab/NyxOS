# Toolkit and session environment.
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland
env = QT_QPA_PLATFORM,wayland;xcb
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = GDK_BACKEND,wayland,x11
env = MOZ_ENABLE_WAYLAND,1
env = ELECTRON_OZONE_PLATFORM_HINT,auto
{% if 'nvidia' in nyx_profile.gpus %}

# NVIDIA. WLR_NO_HARDWARE_CURSORS is deliberately absent — obsolete since
# explicit sync landed in the 555 series.
env = LIBVA_DRIVER_NAME,nvidia
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = NVD_BACKEND,direct
{% elif 'amd' in nyx_profile.gpus %}

# AMD
env = LIBVA_DRIVER_NAME,radeonsi
env = VDPAU_DRIVER,radeonsi
{% elif 'intel' in nyx_profile.gpus %}

# Intel
env = LIBVA_DRIVER_NAME,iHD
{% endif %}
{% if nyx_profile.is_vm | bool %}

# Functional, not cosmetic: Hyper-V exposes no DRI device, so without these
# Hyprland refuses to start rather than running slowly.
env = WLR_RENDERER_ALLOW_SOFTWARE,1
env = LIBGL_ALWAYS_SOFTWARE,1
{% endif %}
