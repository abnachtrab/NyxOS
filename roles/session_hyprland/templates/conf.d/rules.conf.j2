# Float things that have a correct size and should not be tiled.
windowrulev2 = float, class:^(pavucontrol|nm-connection-editor|blueman-manager)$
windowrulev2 = float, class:^(org.kde.polkit-kde-authentication-agent-1)$
windowrulev2 = float, title:^(Picture-in-Picture)$
windowrulev2 = pin,   title:^(Picture-in-Picture)$
windowrulev2 = float, class:^(xdg-desktop-portal-gtk)$

# File chooser portals open small; give them room.
windowrulev2 = size 800 600, class:^(xdg-desktop-portal-gtk)$

# Suppress maximize requests from apps that ask for it on launch.
windowrulev2 = suppressevent maximize, class:.*

# Fix focus grabs on dialogs that report no initial class/title.
windowrulev2 = nofocus, class:^$, title:^$, xwayland:1, floating:1, fullscreen:0, pinned:0
