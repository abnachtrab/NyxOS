# windowrulev2 was merged back into windowrule; v2 is deprecated.
# Float things that have a correct size and should not be tiled.
windowrule = float, class:^(pavucontrol|nm-connection-editor|blueman-manager)$
windowrule = float, class:^(org.kde.polkit-kde-authentication-agent-1)$
windowrule = float, title:^(Picture-in-Picture)$
windowrule = pin,   title:^(Picture-in-Picture)$
windowrule = float, class:^(xdg-desktop-portal-gtk)$

# File chooser portals open small; give them room.
windowrule = size 800 600, class:^(xdg-desktop-portal-gtk)$

# Suppress maximize requests from apps that ask for it on launch.
windowrule = suppressevent maximize, class:.*

# Fix focus grabs on dialogs that report no initial class/title.
windowrule = nofocus, class:^$, title:^$, xwayland:1, floating:1, fullscreen:0, pinned:0
