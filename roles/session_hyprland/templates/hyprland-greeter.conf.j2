# Greeter compositor config. Overwrites the file shipped by hyprlogin-git,
# which defaults to a us,fr layout with an azerty variant and an alt+shift
# toggle. This is a package-owned path, so a hyprlogin update will replace it
# and the role must be re-run.
exec-once = hyprlogin
monitor=,preferred,auto,1

input {
    kb_layout = {{ nyx_keymap }}
    kb_variant =
    kb_options =
}
