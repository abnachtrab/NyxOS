-- NyxOS environment, loaded by illogical-impulse from hypr/custom/env.lua.
--
-- ii's own Environment stage runs before this one and sets the generic
-- session variables (XDG_*, QT_*, GDK_*, MOZ_*), so they are deliberately
-- not repeated here. What ii has no notion of is the machine it is running
-- on: it does no GPU-vendor branching and does not know about VMs.
--
-- Rendered per profile. Check the result with `hyprctl getenv` in a running
-- session rather than assuming.

hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")
{% if nyx_hypr_proton_wayland | bool %}

-- Proton's Wayland backend. Required for HDR, which auto-enables the
-- wine-wayland driver anyway. Override per game with
-- PROTON_ENABLE_WAYLAND=0 %command% in its Steam launch options.
hl.env("PROTON_ENABLE_WAYLAND", "1")
hl.env("PROTON_ENABLE_HDR", "1")
{% endif %}
{% if 'nvidia' in nyx_profile.gpus %}

-- NVIDIA. Set here even if ii already does: custom/ loads after the
-- defaults, so this is last-write-wins rather than a conflict.
-- WLR_NO_HARDWARE_CURSORS is deliberately absent — obsolete since explicit
-- sync landed in the 555 series.
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("NVD_BACKEND", "direct")
{% elif 'amd' in nyx_profile.gpus %}

-- AMD
hl.env("LIBVA_DRIVER_NAME", "radeonsi")
hl.env("VDPAU_DRIVER", "radeonsi")
{% elif 'intel' in nyx_profile.gpus %}

-- Intel
hl.env("LIBVA_DRIVER_NAME", "iHD")
{% endif %}
{% if nyx_profile.is_vm | bool %}

-- Functional, not cosmetic: Hyper-V exposes no DRI device, so without these
-- Hyprland refuses to start rather than running slowly.
hl.env("WLR_RENDERER_ALLOW_SOFTWARE", "1")
hl.env("LIBGL_ALWAYS_SOFTWARE", "1")
{% endif %}
