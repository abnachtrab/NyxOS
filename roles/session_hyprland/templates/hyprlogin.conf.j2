# hyprlogin uses hyprlock's config format, so this file and hyprlock.conf
# stay visually consistent by construction. Colours from roles/theme.

general {
    hide_cursor = false
}

background {
    monitor =
{% if nyx_hypr_wallpaper %}
    path = {{ nyx_hypr_wallpaper }}
    blur_passes = 2
    blur_size = 6
{% else %}
    color = rgb({{ nyx_palette.base }})
{% endif %}
}

input-field {
    monitor =
    size = 320, 48
    outline_thickness = 2
    dots_size = 0.24
    dots_spacing = 0.3
    dots_center = true
    outer_color = rgb({{ nyx_palette[nyx_roles.primary] }})
    inner_color = rgb({{ nyx_palette.surface0 }})
    font_color = rgb({{ nyx_palette.text }})
    fade_on_empty = false
    placeholder_text = <span foreground="##{{ nyx_palette.muted }}">password</span>
    placeholder_text_username = <span foreground="##{{ nyx_palette.muted }}">user</span>
    check_color = rgb({{ nyx_palette[nyx_roles.secondary] }})
    fail_color = rgb({{ nyx_palette[nyx_roles.error] }})
    position = 0, -40
    halign = center
    valign = center
}

label {
    monitor =
    text = $TIME
    color = rgb({{ nyx_palette.text }})
    font_size = 56
    position = 0, 120
    halign = center
    valign = center
}

label {
    monitor =
    text = {{ nyx_name }}
    color = rgb({{ nyx_palette[nyx_roles.primary] }})
    font_size = 14
    position = 0, 60
    halign = center
    valign = center
}
