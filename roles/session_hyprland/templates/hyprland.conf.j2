# Generated by roles/session_hyprland. Edits here are overwritten.
# Colours come from roles/theme via conf.d/theme.conf.

source = ~/.config/hypr/conf.d/theme.conf
{% for part in nyx_hypr_conf_parts %}
source = ~/.config/hypr/conf.d/{{ part }}.conf
{% endfor %}

general {
    gaps_in = 4
    gaps_out = 8
    border_size = 2
    layout = dwindle
}

dwindle {
    pseudotile = true
    preserve_split = true
}

input {
    kb_layout = {{ nyx_keymap | default('us') }}
    follow_mouse = 1
}

decoration {
    rounding = 10
{% if nyx_hypr_effects %}
    blur {
        enabled = true
        size = 6
        passes = 2
    }
    shadow {
        enabled = true
        range = 12
        render_power = 2
    }
{% else %}
    blur {
        enabled = false
    }
    shadow {
        enabled = false
    }
{% endif %}
}

animations {
{% if nyx_hypr_effects %}
    enabled = true
    bezier = smooth, 0.05, 0.9, 0.1, 1.0
    animation = windows, 1, 4, smooth
    animation = fade, 1, 4, smooth
    animation = workspaces, 1, 5, smooth
{% else %}
    enabled = false
{% endif %}
}

misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
}
